{
  "title": "Docker Voice Provider Configurations",
  "description": "Example Docker deployment configurations for voice providers with various setups",
  "providers": [
    {
      "id": "faster-whisper-gpu",
      "type": "faster-whisper",
      "name": "Faster-Whisper with GPU Support",
      "description": "GPU-accelerated speech-to-text with NVIDIA CUDA",
      "config": {
        "image": "fedirz/faster-whisper-server:latest-gpu",
        "port": 8001,
        "containerName": "faster-whisper-gpu",
        "gpuEnabled": true,
        "cpuLimit": "4",
        "memoryLimit": "8g",
        "volumes": {
          "faster-whisper-models": "/root/.cache/huggingface",
          "faster-whisper-cache": "/tmp/whisper-cache"
        },
        "env": {
          "LOG_LEVEL": "INFO",
          "DEFAULT_MODEL_SIZE": "base",
          "COMPUTE_TYPE": "float16",
          "DEVICE": "cuda",
          "DEVICE_INDEX": "0"
        },
        "healthCheck": {
          "endpoint": "http://127.0.0.1:8001/health",
          "interval": 30000,
          "timeout": 10000
        }
      }
    },
    {
      "id": "faster-whisper-cpu",
      "type": "faster-whisper",
      "name": "Faster-Whisper CPU-Only",
      "description": "CPU-based speech-to-text for systems without GPU",
      "config": {
        "image": "fedirz/faster-whisper-server:latest-cpu",
        "port": 8002,
        "containerName": "faster-whisper-cpu",
        "gpuEnabled": false,
        "cpuLimit": "4",
        "memoryLimit": "4g",
        "volumes": {
          "faster-whisper-models": "/root/.cache/huggingface"
        },
        "env": {
          "LOG_LEVEL": "INFO",
          "DEFAULT_MODEL_SIZE": "tiny",
          "COMPUTE_TYPE": "int8"
        },
        "healthCheck": {
          "endpoint": "http://127.0.0.1:8002/health",
          "interval": 30000,
          "timeout": 10000
        }
      }
    },
    {
      "id": "chatterbox-tts",
      "type": "chatterbox",
      "name": "Chatterbox Text-to-Speech",
      "description": "Chatterbox TTS with model caching and volume persistence",
      "config": {
        "image": "chatterbox-tts:latest",
        "port": 5000,
        "containerName": "chatterbox-tts",
        "gpuEnabled": true,
        "cpuLimit": "2",
        "memoryLimit": "2g",
        "volumes": {
          "chatterbox-models": "/app/models",
          "chatterbox-cache": "/app/cache"
        },
        "env": {
          "API_PORT": "5000",
          "DEVICE": "cuda",
          "MODEL_DIR": "/app/models",
          "CACHE_DIR": "/app/cache",
          "TTS_ENGINE": "glow-tts",
          "VOCODER": "hifi-gan"
        },
        "healthCheck": {
          "endpoint": "http://127.0.0.1:5000/api/v1/health",
          "interval": 30000,
          "timeout": 10000
        }
      }
    },
    {
      "id": "whisper-openai",
      "type": "whisper",
      "name": "OpenAI Whisper",
      "description": "OpenAI Whisper STT with medium model",
      "config": {
        "image": "openai/whisper:latest-gpu",
        "port": 8003,
        "containerName": "whisper-openai",
        "gpuEnabled": true,
        "cpuLimit": "4",
        "memoryLimit": "8g",
        "volumes": {
          "whisper-models": "/root/.cache/whisper"
        },
        "env": {
          "MODEL": "medium",
          "DEVICE": "cuda",
          "DEVICE_INDEX": "0",
          "LOG_LEVEL": "INFO"
        },
        "healthCheck": {
          "endpoint": "http://127.0.0.1:8003/health",
          "interval": 30000,
          "timeout": 10000
        }
      }
    },
    {
      "id": "deepgram-self-hosted",
      "type": "deepgram",
      "name": "Deepgram Self-Hosted",
      "description": "Self-hosted Deepgram speech recognition",
      "config": {
        "image": "deepgram-self-hosted:latest",
        "port": 8004,
        "containerName": "deepgram-self-hosted",
        "gpuEnabled": false,
        "cpuLimit": "4",
        "memoryLimit": "8g",
        "volumes": {
          "deepgram-models": "/app/models"
        },
        "env": {
          "PORT": "8080",
          "LOG_LEVEL": "INFO",
          "MODEL_PATH": "/app/models"
        },
        "healthCheck": {
          "endpoint": "http://127.0.0.1:8004/v1/health",
          "interval": 30000,
          "timeout": 10000
        }
      }
    },
    {
      "id": "kokoro-tts",
      "type": "kokoro",
      "name": "Kokoro TTS with Models",
      "description": "Kokoro text-to-speech with persistent model storage",
      "config": {
        "image": "kokoro:latest",
        "port": 8000,
        "containerName": "kokoro-tts",
        "gpuEnabled": true,
        "cpuLimit": "2",
        "memoryLimit": "2g",
        "volumes": {
          "kokoro-models": "/app/models",
          "kokoro-cache": "/app/cache"
        },
        "env": {
          "LOG_LEVEL": "INFO",
          "MODEL_PATH": "/app/models",
          "CACHE_DIR": "/app/cache"
        },
        "healthCheck": {
          "endpoint": "http://127.0.0.1:8000/health",
          "interval": 30000,
          "timeout": 10000
        }
      }
    }
  ],
  "notes": {
    "port_allocation": "Ports are automatically allocated if already in use. Specify preferred port in 'config.port'",
    "gpu_support": "Set 'gpuEnabled' to true for GPU-accelerated providers. Requires NVIDIA Docker runtime",
    "volumes": "Named volumes persist data across container restarts. Models are cached for faster startup",
    "health_checks": "Health check endpoints verify service readiness. Adjust interval and timeout based on model size",
    "environment_variables": "Customize provider behavior through environment variables. See provider documentation",
    "resource_limits": "Set CPU and memory limits to prevent resource exhaustion. Adjust based on available system resources",
    "usage_example": "Use DockerProviderAdapter.createProviderInstance() to deploy with these configs"
  }
}
