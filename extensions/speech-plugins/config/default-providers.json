{
  "$schema": "./provider-config-schema.json",
  "description": "Default voice provider configurations for Clawdbot speech plugins",
  "version": "1.0.0",
  "providers": [
    {
      "id": "whisper-system",
      "type": "stt",
      "name": "Whisper (System)",
      "module": "@clawdbot/speech-plugins/providers/whisper",
      "deployment": {
        "mode": "system",
        "system": {
          "binaryPath": "whisper",
          "workingDir": "/tmp/whisper",
          "env": {
            "WHISPER_MODEL": "base"
          }
        }
      },
      "config": {
        "model": "base",
        "language": "auto",
        "device": "cpu"
      },
      "enabled": true,
      "priority": 100
    },
    {
      "id": "faster-whisper-docker",
      "type": "stt",
      "name": "Faster-Whisper (Docker)",
      "module": "@clawdbot/speech-plugins/providers/faster-whisper",
      "deployment": {
        "mode": "docker",
        "docker": {
          "image": "ghcr.io/openai/faster-whisper",
          "tag": "latest-gpu",
          "containerName": "clawdbot-faster-whisper",
          "volumes": [
            {
              "host": "${HOME}/.cache/whisper",
              "container": "/root/.cache/whisper"
            }
          ],
          "env": {
            "NVIDIA_VISIBLE_DEVICES": "all"
          }
        }
      },
      "config": {
        "model": "medium",
        "language": "auto",
        "device": "cuda",
        "computeType": "float16"
      },
      "enabled": false,
      "priority": 90
    },
    {
      "id": "deepgram-cloud",
      "type": "stt",
      "name": "Deepgram (Cloud)",
      "module": "@clawdbot/speech-plugins/providers/deepgram",
      "deployment": {
        "mode": "cloud",
        "cloud": {
          "endpoint": "https://api.deepgram.com/v1/listen",
          "apiKey": "${DEEPGRAM_API_KEY}",
          "region": "us",
          "timeout": 30000
        }
      },
      "config": {
        "model": "nova-2",
        "language": "en",
        "punctuate": true,
        "diarize": false,
        "smartFormat": true
      },
      "enabled": false,
      "priority": 110
    },
    {
      "id": "kokoro-system",
      "type": "tts",
      "name": "Kokoro TTS (System)",
      "module": "@clawdbot/speech-plugins/providers/kokoro",
      "deployment": {
        "mode": "system",
        "system": {
          "binaryPath": "kokoro-tts",
          "workingDir": "/tmp/kokoro",
          "env": {
            "KOKORO_VOICE": "af_sky"
          }
        }
      },
      "config": {
        "voice": "af_sky",
        "sampleRate": 22050,
        "format": "wav",
        "speed": 1.0
      },
      "enabled": true,
      "priority": 100
    },
    {
      "id": "cartesia-cloud",
      "type": "tts",
      "name": "CartesiaAI (Cloud)",
      "module": "@clawdbot/speech-plugins/providers/cartesia",
      "deployment": {
        "mode": "cloud",
        "cloud": {
          "endpoint": "https://api.cartesia.ai/tts/bytes",
          "apiKey": "${CARTESIA_API_KEY}",
          "timeout": 30000
        }
      },
      "config": {
        "modelId": "sonic-english",
        "voiceId": "a0e99841-438c-4a64-b679-ae501e7d6091",
        "outputFormat": {
          "container": "wav",
          "encoding": "pcm_s16le",
          "sampleRate": 24000
        },
        "language": "en"
      },
      "enabled": false,
      "priority": 110
    },
    {
      "id": "elevenlabs-cloud",
      "type": "tts",
      "name": "ElevenLabs (Cloud)",
      "module": "@clawdbot/speech-plugins/providers/elevenlabs",
      "deployment": {
        "mode": "cloud",
        "cloud": {
          "endpoint": "https://api.elevenlabs.io/v1/text-to-speech",
          "apiKey": "${ELEVENLABS_API_KEY}",
          "timeout": 30000
        }
      },
      "config": {
        "voiceId": "21m00Tcm4TlvDq8ikWAM",
        "modelId": "eleven_multilingual_v2",
        "voiceSettings": {
          "stability": 0.5,
          "similarityBoost": 0.75,
          "style": 0.0,
          "useSpeakerBoost": true
        },
        "outputFormat": "mp3_44100_128"
      },
      "enabled": false,
      "priority": 105
    },
    {
      "id": "chatterbox-docker",
      "type": "tts",
      "name": "Chatterbox TTS (Docker)",
      "module": "@clawdbot/speech-plugins/providers/chatterbox",
      "deployment": {
        "mode": "docker",
        "docker": {
          "image": "ghcr.io/chatterbox/tts",
          "tag": "latest",
          "containerName": "clawdbot-chatterbox-tts",
          "ports": [
            {
              "host": 5002,
              "container": 5002
            }
          ],
          "volumes": [
            {
              "host": "${HOME}/.cache/chatterbox",
              "container": "/app/models"
            }
          ]
        }
      },
      "config": {
        "voice": "en_US-amy-medium",
        "sampleRate": 22050,
        "format": "wav"
      },
      "enabled": false,
      "priority": 95
    }
  ]
}
